{
    "name": "control-air/intacct-php-sdk",
    "description": "A framework-agnostic, strongly typed PHP SDK for the Sage Intacct REST API.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sage",
        "intacct",
        "rest",
        "oauth2",
        "laravel"
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.10",
        "guzzlehttp/psr7": "^2.7",
        "laravel/pint": "^1.24",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "ControlAir\\Intacct\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ControlAir\\Intacct\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "analyse": "phpstan analyse --memory-limit=1G --debug --no-progress",
        "format": "pint",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
