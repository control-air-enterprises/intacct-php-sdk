# Copy this file to .env. Never commit real credentials.
SAGE_INTACCT_CLIENT_ID=
SAGE_INTACCT_CLIENT_SECRET=
SAGE_INTACCT_USER_ID=
SAGE_INTACCT_COMPANY_ID=

# Optional: scopes the client-credentials token to one entity.
SAGE_INTACCT_ENTITY_ID=

# Optional: the Job event-queue trigger test (composer test:webhooks).
# Key of a sandbox job the test may edit to fire the trigger. Leave empty to skip that step.
SAGE_INTACCT_TRIGGER_TEST_JOB_KEY=
# Set to true to let the test acknowledge, and permanently remove, the first queued batch.
SAGE_INTACCT_TRIGGER_TEST_ACKNOWLEDGE=
